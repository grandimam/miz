#!/usr/bin/env bash
set -e

MIZ_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS=(miz career curriculum learn probe book resume)

skill_src() {
  case "$1" in
    miz) echo "$MIZ_DIR/home" ;;
    *) echo "$MIZ_DIR/$1" ;;
  esac
}

OPENCODE_SKILLS="$HOME/.config/opencode/skills"
OPENCODE_COMMANDS="$HOME/.config/opencode/command"
CLAUDE_SKILLS="$HOME/.claude/skills"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_SKILLS="$CODEX_HOME/skills"
MIZ_HOME="${MIZ_HOME:-$HOME/.miz}"
verified_codex=0

verify_install() {
  local dest="$1"
  local label="$2"
  local missing=0

  for skill in "${SKILLS[@]}"; do
    if [ ! -f "$dest/$skill/SKILL.md" ]; then
      echo "warning: $label skill missing SKILL.md at $dest/$skill/SKILL.md" >&2
      missing=1
    fi
  done

  if [ "$missing" -eq 0 ]; then
    echo "verified $label skills in $dest"
    if [ "$label" = "Codex" ]; then
      verified_codex=1
    fi
  fi
}

prune_stale() {
  local dest="$1"
  [ -d "$dest" ] || return 0
  for entry in "$dest"/*; do
    if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
      continue
    fi
    local name keep skill
    name="$(basename "$entry")"
    keep=0
    for skill in "${SKILLS[@]}"; do
      [ "$name" = "$skill" ] && keep=1
    done
    if [ "$keep" -eq 0 ]; then
      rm -rf "$entry"
      echo "pruned stale $entry"
    fi
  done
}

cleanup_broken_links() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  for entry in "$dir"/*; do
    if [ -L "$entry" ] && [ ! -e "$entry" ]; then
      rm "$entry"
      echo "removed broken symlink $entry"
    fi
  done
}

install_opencode_commands() {
  mkdir -p "$OPENCODE_COMMANDS"
  for stale in career curriculum learn probe book resume; do
    if [ -f "$OPENCODE_COMMANDS/$stale.md" ]; then
      rm "$OPENCODE_COMMANDS/$stale.md"
      echo "removed old command $OPENCODE_COMMANDS/$stale.md"
    fi
  done
  cat > "$OPENCODE_COMMANDS/miz.md" <<'MD'
---
description: Miz - a stack for building and validating expertise. Router: /miz career <args>, /miz curriculum <topic>, /miz learn <draft>, /miz probe <topic> [ch], /miz book <topic>, /miz resume [improve|tailor <job>], or /miz alone for the status dashboard.
---
Follow the miz skill and route this subcommand: $ARGUMENTS
MD
  echo "wrote opencode command -> $OPENCODE_COMMANDS/miz.md"
}

install_to() {
  local dest="$1"
  mkdir -p "$dest"
  prune_stale "$dest"
  for skill in "${SKILLS[@]}"; do
    ln -snf "$(skill_src "$skill")" "$dest/$skill"
    echo "linked $dest/$skill"
  done
}

install_opencode=0
install_claude=0
install_codex=0
wire_agents=0

if [ "$#" -eq 0 ]; then
  [ -d "$HOME/.config/opencode" ] && install_opencode=1
  [ -d "$HOME/.claude" ] && install_claude=1
  [ -d "$CODEX_HOME" ] && install_codex=1
fi

for arg in "$@"; do
  case "$arg" in
    --opencode) install_opencode=1 ;;
    --claude) install_claude=1 ;;
    --codex) install_codex=1 ;;
    --wire) wire_agents=1 ;;
    --all)
      install_opencode=1
      install_claude=1
      install_codex=1
      ;;
    *)
      echo "unknown option: $arg" >&2
      echo "usage: ./setup [--codex] [--claude] [--opencode] [--all] [--wire]" >&2
      exit 1
      ;;
  esac
done

if [ "$install_opencode" -eq 1 ]; then
  install_to "$OPENCODE_SKILLS"
  verify_install "$OPENCODE_SKILLS" "OpenCode"
  install_opencode_commands
  cleanup_broken_links "$CLAUDE_SKILLS"
fi

if [ "$install_claude" -eq 1 ]; then
  install_to "$CLAUDE_SKILLS"
  verify_install "$CLAUDE_SKILLS" "Claude"
fi

if [ "$install_codex" -eq 1 ]; then
  install_to "$CODEX_SKILLS"
  verify_install "$CODEX_SKILLS" "Codex"
fi

mkdir -p "$MIZ_HOME/topics" "$MIZ_HOME/bin"
for b in miz-topics miz-status miz-book; do
  ln -snf "$MIZ_DIR/bin/$b" "$MIZ_HOME/bin/$b"
  chmod +x "$MIZ_DIR/bin/$b" 2>/dev/null || true
done
echo "linked bin/ -> $MIZ_HOME/bin"

AGENTS_SNIPPET='## miz
Build expertise. Validate it. Own it. A stack for building and validating expertise. Skills: /miz (status + router), /career (profile, job-fit, interview prep, tracking), /curriculum, /learn, /probe, /book (learning engine), /resume (audit + improve + tailor resume). State lives in ~/.miz/. Seed a topic with /curriculum <topic>; review drafts with /learn; build and verify understanding with /probe; /career init sets up the career layer; /career add job / /career prep <company> / /career analyze <company> / /career learn close the loop for job hunting.'

if [ "$wire_agents" -eq 1 ] && [ -f "AGENTS.md" ]; then
  if ! grep -q '^## miz$' AGENTS.md 2>/dev/null; then
    printf '\n%s\n' "$AGENTS_SNIPPET" >>AGENTS.md
    echo "wired AGENTS.md"
  fi
fi

echo "done. state lives in $MIZ_HOME/"
echo "skills: ${SKILLS[*]}"

if [ "$verified_codex" -eq 1 ]; then
  echo "codex note: if the skills do not appear immediately, fully restart Codex or start a new chat."
  echo "codex note: the install is complete once ~/.codex/skills/<skill>/SKILL.md exists for each skill."
fi

if [ "$install_opencode" -eq 1 ]; then
  echo "opencode note: skills and the command are read at startup - quit and restart opencode to pick up /miz and its subcommands (/miz career, /miz curriculum, /miz learn, /miz probe, /miz book)."
fi
